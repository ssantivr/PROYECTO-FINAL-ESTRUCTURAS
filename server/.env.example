NODE_ENV=development
PORT=4000

# PostgreSQL (con Docker: docker compose up -d usa estas mismas credenciales)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/arquila?schema=public"
CORS_ORIGIN="http://localhost:5173"

# Sesiones JWT: use una cadena larga y aleatoria (mínimo 16 caracteres)
JWT_SECRET=change_this_in_development
JWT_EXPIRES_IN=8h

# IA local con LM Studio (servidor compatible con OpenAI)
AI_PROVIDER=lmstudio
AI_BASE_URL=http://localhost:1234/v1
# Identificador del modelo tal como aparece en LM Studio; vacío = primer modelo cargado
AI_MODEL=YOUR_LOCAL_MODEL
AI_TIMEOUT_MS=90000
AI_TEMPERATURE=0.3
