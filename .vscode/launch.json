{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (depurar)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/server",
      "runtimeArgs": ["--import", "tsx"],
      "program": "${workspaceFolder}/server/src/index.ts",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"]
    },
    {
      "name": "Web en Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "ARQUILA: web"
    }
  ],
  "compounds": [
    {
      "name": "ARQUILA completo (API + web)",
      "configurations": ["API (depurar)", "Web en Chrome"],
      "stopAll": true
    }
  ]
}
