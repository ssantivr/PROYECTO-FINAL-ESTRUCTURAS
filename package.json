{
  "name": "arquila",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "npm install && npm --prefix server install && npm --prefix server run db:generate",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "npm --prefix server run dev",
    "build": "tsc --noEmit && vite build && npm --prefix server run build",
    "build:web": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && npm --prefix server run typecheck",
    "test": "npm --prefix server test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "npm --prefix server run db:migrate",
    "db:deploy": "npm --prefix server run db:deploy",
    "db:seed": "npm --prefix server run db:seed",
    "db:generate": "npm --prefix server run db:generate"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "description": "ARQUILA · Plataforma de arquitectura, terrenos, planos, materiales, visualización 3D e IA local (LM Studio)"
}
